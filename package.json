{
  "name": "eidos-academy",
  "version": "0.3.0",
  "private": true,
  "description": "Academy for Eidos MD: quizzes and flashcard decks on a project's content, ordered courses, and every person's progress over time.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
